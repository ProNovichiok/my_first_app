[Unit]
Description=Baltic Drive Node.js server and Telegram webhook
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rental
WorkingDirectory=/opt/baltic-drive
ExecStart=/usr/bin/node --env-file=/opt/baltic-drive/.env.node /opt/baltic-drive/server/local.mjs
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target

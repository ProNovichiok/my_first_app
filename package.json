    "export": "node --env-file-if-exists=.env scripts/export.js"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "zod": "^4.1.12"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}